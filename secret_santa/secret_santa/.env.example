# Copy this file to .env and fill in real values:
#   cp .env.example .env
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Keep the value stable across restarts, otherwise member hashed_email breaks.
HASH_SALT=your-secret-salt
DJANGO_ALLOWED_HOSTS=0.0.0.0,127.0.0.1
DJANGO_DEFAULT_FROM_EMAIL=Таємний Санта <noreply@example.com>
DJANGO_EMAIL_FAIL_SILENTLY=True